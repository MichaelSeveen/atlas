    "read_permission": "audit.events.read",
    "write_path": "synchronous-application-service",
    "privileged_mutation_atomicity": "same-postgresql-transaction",
    "denied_high_risk_persistence": "required-before-final-response",
    "persistence_outage": "deny-action-and-return-service-unavailable",
    "asyncapi_publication": "not-implemented-in-phase-01",
