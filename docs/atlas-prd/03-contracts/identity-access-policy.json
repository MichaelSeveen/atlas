      "browser_storage": "memory-only",
      "random_bits": 256,
      "bound_to": "session-id-and-rotation-version",
      "required_for": "all-cookie-authenticated-mutations"
    },
    "policies": [
      {
        "population": "customer",
        "idle_minutes": 30,
        "absolute_minutes": 720,
        "minimum_assurance": "baseline"
      },
      {
        "population": "merchant",
        "idle_minutes": 20,
        "absolute_minutes": 480,
        "minimum_assurance": "baseline"
      },
      {
        "population": "workforce",
        "idle_minutes": 10,
        "absolute_minutes": 60,
        "minimum_assurance": "phishing_resistant"
      }
    ],
    "rotate_on": ["login", "step-up", "privilege-change", "tenant-switch"],
    "old_session_grace_seconds": 0,
    "maximum_concurrent_sessions_per_principal": 10,
    "oidc_clock_skew_seconds": 60,
    "upstream_token_retention": "none-after-validated-callback",
    "idp_outage_policy": {
      "new_login": "deny",
      "new_step_up": "deny",
      "existing_low_risk_reads": "allow-until-existing-idle-or-absolute-expiry",
      "high_risk_actions_without_fresh_assurance": "deny",
      "session_lifetime_extension": "forbidden"
    }
  },
  "tenancy": {
